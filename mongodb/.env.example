# Copy to app/.env, or export the same variables through .envrc.
#
# Docker Compose reads app/.env automatically because it sits beside the compose
# files. The utils/ scripts run on the host and read the environment, so if you
# only create app/.env you will need to export MONGO_ROOT_USER and
# MONGO_ROOT_PASSWORD before running them. Using .envrc covers both.

# Pinned to an exact patch, never a floating tag. mongo:8.0 is a range, not a
# version: any pull can move the patch level with nothing in the diff to show
# it. Read what the floating tag currently resolves to, then pin that.
MONGO_TAG=8.0.29

MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=changeme

MONGO_DB=appdb

# 27018 rather than 27017, so this stack cannot collide with another mongod
# already listening locally.
MONGO_EXPOSED_PORT=27018

RS_NAME=rs0

# The member-hostname trap. rs.initiate() records this name, and every client is
# redirected to it after the handshake, whatever it used as a seed. This
# container answers to both `mongo` (the compose service name) and `mongodb`
# (the container name), which is the situation to be in when two different
# clients each hardcode a different one. Exercise 4 varies this value.
RS_MEMBER_HOST=mongodb:27017

# What the one-shot initiator connects to, before there is any topology to
# discover. Not the same question as RS_MEMBER_HOST.
RS_INIT_TARGET=mongo:27017

# Set per command rather than here, since the exercises vary the user, the seed
# host and the parameters. See the README.
# MONGO_URI=mongodb://root:changeme@mongodb:27017/appdb?replicaSet=rs0&authSource=admin
